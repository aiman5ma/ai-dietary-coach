# ----------------------------------------------------------------------------
# AI Dietary Coach — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` for local development:
#
#   cp .env.example .env
#
# Server variables are read only by /api/ai (the Vite dev middleware and
# the Vercel function). Do NOT prefix them with VITE_. Vite would ship
# any VITE_ value to the browser.
#
# On Vercel, set the same server variables in Project Settings → Environment
# Variables. Never put the OpenAI key in a VITE_ variable.
# ----------------------------------------------------------------------------

# Secret. https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Same Supabase project the browser uses. Project Settings → API.
# The anon key is public. Row Level Security limits each user to their own rows.
# SUPABASE_URL must be the project URL, not a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Browser. Safe to expose. Must match the project above.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
