# ----------------------------------------------------------------------------
# AI Dietary Coach — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own OpenAI API key.
#
#   cp .env.example .env
#
# Get your API key at https://platform.openai.com/api-keys
#
# The key must be prefixed with VITE_ so Vite exposes it to the browser.
# Anything you put here is bundled into the client — never commit a real
# .env file to source control.
# ----------------------------------------------------------------------------

VITE_OPENAI_API_KEY=your_openai_api_key_here
